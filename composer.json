{
  "name": "olein-jp/od-mesh-gradient",
  "description": "WordPress mesh gradient plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "inc2734/wp-github-plugin-updater": "^3.1.18"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.4.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "platform": { "php": "7.4.33" },
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "format": "phpcbf"
  }
}
