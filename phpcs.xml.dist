<?xml version="1.0"?>
<ruleset name="OD Mesh Gradient">
	<description>OD Mesh Gradient の WordPress コーディング規約。</description>
	<file>od-mesh-gradient.php</file>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="od-mesh-gradient"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="od_mesh_gradient"/></property>
		</properties>
	</rule>
</ruleset>
